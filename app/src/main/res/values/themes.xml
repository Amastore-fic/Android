<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (siempre modo claro). -->
    <style name="Base.Theme.CompraSegura" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorOnSecondary">@color/dark_primary</item>

        <!-- Fondo y superficies -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Barra de estado y navegación -->
        <item name="android:statusBarColor">@color/dark_primary</item>
        <item name="android:navigationBarColor">@color/dark_primary</item>
    </style>

    <style name="Theme.CompraSegura" parent="Base.Theme.CompraSegura" />
</resources>